/* =========================================
   1. GENERAL SETTINGS
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #ffffff;
    color: #393341;
    line-height: 1.6;
}

:root {
    --primary: #9275c9;
    --primary-dark: #7656ad;
    --primary-light: #eee8f8;
    --purple-soft: #f8f5fc;
    --text-dark: #393341;
    --text-muted: #85808c;
    --white: #ffffff;
}


/* =========================================
   2. NAVIGATION BAR
========================================= */

.navbar {
    min-height: 75px;
    padding: 12px 0;
    background-color: #ffffff;
}

.navbar-brand {
    display: flex;
    align-items: center;
    color: var(--text-dark) !important;
    font-size: 18px;
    font-weight: 700;
}

.brand-icon {
    width: 40px;
    height: 40px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    background-color: var(--primary);
    color: white;
    border-radius: 11px;
    font-size: 16px;
    font-weight: 700;
}

.navbar-toggler {
    border-color: #e5dcef;
    box-shadow: none !important;
}

.navbar-toggler:focus {
    box-shadow: none;
}

.brand-logo {
    width: 70px;
    height: 70px;
    object-fit: contain;
    margin-right: 12px;
}


/* =========================================
   3. BUTTONS
========================================= */

.btn-purple {
    display: inline-block;
    padding: 10px 25px;
    background-color: var(--primary);
    color: #ffffff;
    border: 1px solid var(--primary);
    border-radius: 9px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
}

.btn-purple:hover {
    background-color: var(--primary-dark);
    border-color: var(--primary-dark);
    color: #ffffff;
    transform: translateY(-2px);
}


/* =========================================
   4. HERO SECTION
========================================= */

.hero-section {
    min-height: 570px;
    position: relative;
    display: flex;
    align-items: center;

    background-image: url('../images/uitmck-campus.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.hero-overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
        90deg,
        rgba(35, 23, 52, 0.78),
        rgba(55, 38, 78, 0.48)
    );
}

.hero-content {
    position: relative;
    z-index: 2;
    padding-top: 80px;
    padding-bottom: 80px;
    color: #ffffff;
}

.hero-title {
    font-size: 58px;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 18px;
    letter-spacing: -1px;
}

.hero-content h2 {
    font-size: 29px;
    font-weight: 600;
    margin-bottom: 18px;
}

.hero-description {
    max-width: 580px;
    color: #f0eaf7;
    font-size: 17px;
    line-height: 1.8;
}

.hero-content .btn {
    margin-top: 15px;
}


/* =========================================
   5. STATISTICS SECTION
========================================= */

.statistics-section {
    background-color: var(--purple-soft);
    padding: 75px 0;
}

.statistics-section .row.text-center {
    align-items: stretch;
}

.statistics-section .row.text-center > div {
    padding: 25px 10px;
    background-color: #ffffff;
    border: 1px solid #eee8f5;
    border-radius: 13px;
    box-shadow: 0 4px 15px rgba(85, 60, 120, 0.04);
    transition: all 0.3s ease;
}

.statistics-section .row.text-center > div:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 22px rgba(85, 60, 120, 0.09);
}

.statistics-section .row.text-center h2 {
    color: var(--primary-dark);
    font-size: 35px;
    font-weight: 800;
    margin-bottom: 5px;
}

.statistics-section .row.text-center p {
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 0;
}


/* =========================================
   6. CHART CARDS
========================================= */

.chart-card {
    height: 100%;
    padding: 28px;
    background-color: #ffffff;
    border: 1px solid #eee8f5;
    border-radius: 15px;
    box-shadow: 0 4px 18px rgba(85, 60, 120, 0.04);
    transition: all 0.3s ease;
}

.chart-card:hover {
    box-shadow: 0 8px 25px rgba(85, 60, 120, 0.08);
}

.chart-heading {
    color: var(--text-dark);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 7px;
}

.chart-label {
    color: var(--text-muted);
    font-size: 13px;
    margin-bottom: 20px;
}

.chart-container {
    position: relative;
    width: 100%;
    height: 300px;
}


/* =========================================
   7. FOOTER
========================================= */

.footer {
    background-color: #30263d;
    color: #ffffff;
    padding: 25px 0;
}

.footer p {
    color: #d8cfe2;
    font-size: 13px;
}


/* =========================================
   8. LOGIN PAGE
========================================= */

.login-page {
    min-height: 100vh;
    background: linear-gradient(
        135deg,
        #f8f5fc,
        #eee8f8,
        #f5f0fb
    );

    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
}

.login-card {
    width: 100%;
    max-width: 450px;
    background-color: #ffffff;
    padding: 40px;
    border-radius: 20px;

    border: 1px solid #eee8f5;

    box-shadow: 0 12px 35px rgba(85, 60, 120, 0.12);
}

/* Login Logo */

.login-card .brand-logo {
    width: 90px;
    height: 90px;
    object-fit: contain;
    margin-right: 0;
    margin-bottom: 15px;
}

/* Login Heading */

.login-card h3 {
    color: var(--text-dark);
    font-size: 25px;
    font-weight: 700;
}

.login-card .text-muted {
    color: var(--text-muted) !important;
    font-size: 14px;
}


/* =========================================
   9. LOGIN FORM
========================================= */

.login-card .form-label {
    color: var(--text-dark);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 7px;
}

.login-card .form-control {
    width: 100%;
    padding: 12px 14px;

    border: 1px solid #e5dcef;
    border-radius: 9px;

    background-color: #ffffff;
    color: var(--text-dark);

    font-size: 14px;
    transition: all 0.3s ease;
}

.login-card .form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(146, 117, 201, 0.12);
    outline: none;
}

.login-card .form-control::placeholder {
    color: #aaa3b3;
}


/* =========================================
   10. LOGIN BUTTON
========================================= */

.btn-login {
    width: 100%;
    padding: 13px;

    background-color: var(--primary);
    color: #ffffff;

    border: none;
    border-radius: 9px;

    font-size: 15px;
    font-weight: 600;

    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-login:hover {
    background-color: var(--primary-dark);
    color: #ffffff;
    transform: translateY(-2px);

    box-shadow: 0 5px 15px rgba(118, 86, 173, 0.20);
}


/* =========================================
   11. LOGIN MESSAGE AND BACK LINK
========================================= */

#message {
    font-size: 13px;
}

.back-link {
    color: var(--primary-dark);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: 0.3s;
}

.back-link:hover {
    color: var(--primary);
    text-decoration: underline;
}


/* =========================================
   12. RESPONSIVE DESIGN
========================================= */

@media (max-width: 991px) {

    .hero-section {
        min-height: 500px;
    }

    .hero-title {
        font-size: 48px;
    }

    .hero-content h2 {
        font-size: 25px;
    }

}


@media (max-width: 767px) {

    .hero-section {
        min-height: 480px;
        background-position: center;
    }

    .hero-content {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .hero-title {
        font-size: 39px;
    }

    .hero-content h2 {
        font-size: 22px;
    }

    .hero-description {
        font-size: 15px;
    }

    .statistics-section {
        padding: 50px 0;
    }

    .statistics-section .row.text-center h2 {
        font-size: 25px;
    }

    .statistics-section .row.text-center p {
        font-size: 11px;
    }

    .chart-card {
        padding: 20px;
    }

    .chart-container {
        height: 260px;
    }

    .login-card {
        padding: 30px 22px;
    }

    .login-card .brand-logo {
        width: 80px;
        height: 80px;
    }

}


@media (max-width: 400px) {

    .hero-title {
        font-size: 32px;
    }

    .statistics-section .row.text-center > div {
        padding: 18px 5px;
    }

    .login-card {
        padding: 25px 18px;
    }

}


/* =========================================
   13. DASHBOARD PAGES
========================================= */

.dashboard-body {
    min-height: 100vh;
    background-color: var(--purple-soft);
}

.dashboard-heading {
    margin-top: 35px;
    margin-bottom: 25px;
}

.dashboard-heading h2 {
    color: var(--text-dark);
    font-size: 27px;
    font-weight: 700;
    margin-bottom: 5px;
}

.dashboard-heading p {
    color: var(--text-muted);
    font-size: 14px;
}


/* Dashboard Statistics Cards */

.dashboard-card {
    height: 100%;
    padding: 25px;
    background-color: var(--white);
    border: 1px solid #eee8f5;
    border-radius: 14px;
    box-shadow: 0 4px 15px rgba(85, 60, 120, 0.05);
    transition: all 0.3s ease;
}

.dashboard-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 22px rgba(85, 60, 120, 0.10);
}

.dashboard-card h3 {
    color: var(--primary-dark);
    font-size: 30px;
    font-weight: 800;
    margin-bottom: 5px;
}

.dashboard-card p {
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 0;
}


/* =========================================
   14. QUICK ACTION CARDS
========================================= */

.action-card {
    display: block;
    height: 100%;
    padding: 25px;
    background-color: var(--white);
    border: 1px solid #eee8f5;
    border-radius: 14px;
    text-decoration: none;
    color: var(--text-dark);
    box-shadow: 0 4px 15px rgba(85, 60, 120, 0.04);
    transition: all 0.3s ease;
}

.action-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    color: var(--primary-dark);
    box-shadow: 0 8px 22px rgba(85, 60, 120, 0.10);
}

.action-card i {
    display: block;
    color: var(--primary);
    font-size: 30px;
    margin-bottom: 12px;
}

.action-card h5 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 7px;
}

.action-card p {
    color: var(--text-muted);
    font-size: 13px;
    margin-bottom: 0;
}


/* =========================================
   15. CONTENT AND TABLE SECTIONS
========================================= */

.content-card {
    padding: 25px;
    margin-bottom: 25px;
    background-color: var(--white);
    border: 1px solid #eee8f5;
    border-radius: 14px;
    box-shadow: 0 4px 15px rgba(85, 60, 120, 0.04);
}

.content-card h4 {
    color: var(--text-dark);
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 20px;
}

.table {
    vertical-align: middle;
    font-size: 14px;
}

.table thead th {
    background-color: var(--primary-light);
    color: var(--primary-dark);
    font-weight: 700;
    border-bottom: none;
    padding: 14px;
    white-space: nowrap;
}

.table tbody td {
    padding: 13px;
    color: var(--text-dark);
}

.table tbody tr:hover {
    background-color: #faf8fd;
}

.table-responsive {
    border-radius: 10px;
}


/* =========================================
   16. FORM SECTIONS
========================================= */

.form-card {
    max-width: 850px;
    margin: 30px auto;
    padding: 30px;
    background-color: var(--white);
    border: 1px solid #eee8f5;
    border-radius: 16px;
    box-shadow: 0 5px 20px rgba(85, 60, 120, 0.06);
}

.form-card h3 {
    color: var(--text-dark);
    font-size: 23px;
    font-weight: 700;
    margin-bottom: 8px;
}

.form-card .form-label {
    color: var(--text-dark);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 7px;
}

.form-card .form-control,
.form-card .form-select {
    padding: 11px 13px;
    border: 1px solid #e5dcef;
    border-radius: 9px;
    font-size: 14px;
}

.form-card .form-control:focus,
.form-card .form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(146, 117, 201, 0.12);
}

.form-card textarea {
    min-height: 130px;
    resize: vertical;
}

.form-card .btn {
    padding: 10px 22px;
    border-radius: 9px;
    font-weight: 600;
}


/* =========================================
   17. STATUS LABELS
========================================= */

.badge {
    padding: 7px 11px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
}


/* =========================================
   18. SEARCH AND FILTER
========================================= */

.search-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
}

.search-filter .form-control,
.search-filter .form-select {
    min-height: 42px;
    border: 1px solid #e5dcef;
    border-radius: 9px;
    font-size: 14px;
}

.search-filter .form-control:focus,
.search-filter .form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(146, 117, 201, 0.12);
}


/* =========================================
   19. COMPLAINT DETAILS
========================================= */

.complaint-info {
    padding: 20px;
    background-color: #faf8fd;
    border: 1px solid #eee8f5;
    border-radius: 12px;
    margin-bottom: 20px;
}

.complaint-info p {
    margin-bottom: 12px;
    font-size: 14px;
    color: var(--text-dark);
}

.complaint-info strong {
    color: var(--primary-dark);
}

.complaint-image {
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
    border-radius: 10px;
    margin-top: 10px;
}


/* =========================================
   20. RESPONSIVE DASHBOARD
========================================= */

@media (max-width: 767px) {

    .dashboard-heading h2 {
        font-size: 23px;
    }

    .dashboard-card {
        padding: 20px;
    }

    .dashboard-card h3 {
        font-size: 25px;
    }

    .action-card {
        padding: 20px;
    }

    .content-card {
        padding: 18px;
    }

    .form-card {
        margin: 20px auto;
        padding: 22px 17px;
    }

    .form-card h3 {
        font-size: 20px;
    }

    .search-filter {
        flex-direction: column;
    }

    .search-filter .form-control,
    .search-filter .form-select {
        width: 100%;
    }

}
